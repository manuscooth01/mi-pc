{
  "name": "Mi PC Virtual - Linux GUI",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  },

  "postCreateCommand": "bash .devcontainer/setup-gui.sh || echo 'Setup con warnings, pero continua'",

  "forwardPorts": [5901, 6080, 47990],
  "portsAttributes": {
    "5901": { "label": "VNC - RVNC Viewer", "onAutoForward": "notify", "visibility": "public" },
    "6080": { "label": "noVNC Web - Celular", "onAutoForward": "openBrowser", "visibility": "public" },
    "47990": { "label": "Sunshine - Moonlight", "onAutoForward": "notify", "visibility": "public" }
  },

  "remoteUser": "vscode"
}
