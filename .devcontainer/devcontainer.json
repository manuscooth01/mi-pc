{
  "name": "Mi PC Virtual - Linux GUI",
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "echo 'Codespace listo - ejecuta bash .devcontainer/setup-gui.sh para instalar GUI'",
  "forwardPorts": [5901, 6080, 47990],
  "portsAttributes": {
    "5901": { "label": "VNC - RVNC Viewer", "onAutoForward": "notify", "visibility": "public" },
    "6080": { "label": "noVNC Web - Celular", "onAutoForward": "openBrowser", "visibility": "public" },
    "47990": { "label": "Sunshine - Moonlight", "onAutoForward": "notify", "visibility": "public" }
  },
  "remoteUser": "vscode"
}
